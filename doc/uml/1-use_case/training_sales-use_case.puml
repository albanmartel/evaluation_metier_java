@startuml
left to right direction

/' --- ACTEURS --- '/
actor "Visiteur\n(Non connecté)" as visiteur
actor "Utilisateur connecté" as utilisateur

' Alignement vertical : Visiteur en haut
visiteur <|-- utilisateur


rectangle "Application Vente de Formations" {

  usecase "Consulter formations" as UC_Liste
  note right of UC_Liste
    Regroupe :
    - Affichage global
    - Recherche par mot-clé
    - Filtrage (Présentiel / Distanciel)
  end note

  usecase "Gérer panier" as UC_Panier
  note right of UC_Panier
    Regroupe :
    - Créer / Vider le panier
    - Ajouter / Retirer une formation
    
    Règle :
    - Un panier valide doit contenir 
      au moins 1 formation pour commander
  end note

  usecase "Créer compte" as UC_Creer
  usecase "S'authentifier" as UC_Authentification

  usecase "Passer commande" as UC_Commande
  note right of UC_Commande
    Regroupe :
    - Validation du panier
    - Ajout du client bénéficiaire
    
    Règle :
    - Toute commande doit être 
      obligatoirement associée à un client
  end note
}

/' --- RELATIONS ACTEURS <--> CAS D'UTILISATION ---'/

visiteur -- UC_Liste
visiteur -- UC_Panier
visiteur -- UC_Creer

utilisateur -- UC_Authentification
utilisateur -- UC_Commande
@enduml
