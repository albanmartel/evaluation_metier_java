@startuml TrainingSallesApplication
left to right direction

class TrainingCourse{
    -int idCourse
    -string nameCourse
    -string descriptionCourse
    -string TrainingFormat
    -int duration
    -double price
    + trainingCourseDictionnary()
    + searchByName()
    + filterByTrainingCourseFormat()
    + displayFormatArray()

}

class Order{
    -int idOrder
    -dateTime orderDate
    -int idClient
    -int idUser
}

class OrderLine{
    -int idOrderLine
    -int idOrder
    -int idCourse
    -double unitPrice
    -int quantity
}

class Client{
    -int idClient
	-string firstName
    -string lastName
    -string email
    -string phoneNumber
    -string address
    -string street
    -string city
}

class User{
    - int idUser
    - string login
    - string password
    + authenticate()
    + purchases()
    + logIn()
    + logOut()
    + pays()
} 


Order "*" <--> "1" Client : benefits >

User "1" <--> "*" Order : purchases < 

Order "1" <--> "1..*" OrderLine : takes >

OrderLine "1" <--> "*" TrainingCourse : includes >


@enduml
