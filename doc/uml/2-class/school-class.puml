@startuml School

abstract class TrainingCourse
{
    -int idCourse
    -string nameCourse
    -string descriptionCourse
    -string TrainingFormat
    -int duration
    -BigDecimal price
}

class Teacher 
{
    -date start_date
}

class Student
{
    -integer student_nbr
}

class Client
{
    -int idCourse
	-string firstName
    -string lastName
    -string email
    -string phoneNumber
    -string address
    -string street
    -string city
}
 
class Course
{
    -string name
    -date start_date
    -date end_date
} 


TrainingCourse <|-- Student 

TrainingCourse <|-- Teacher

TrainingCourse "1" --> "1" Client : lives >

Student "0..n" <--> "0..n" Course : takes >

Course "1..n" <--u> "1" Teacher : teaches < 


@enduml
